# V23 production deployment. Copy to .env.production and replace every placeholder.
ROUTEPLAN_DOMAIN=routeplan.example.com
TLS_EMAIL=admin@example.com
ROUTEPLAN_PUBLIC_URL=https://routeplan.example.com

# GitHub Container Registry prefix. Images use -backend and -frontend suffixes.
ROUTEPLAN_IMAGE_PREFIX=ghcr.io/your-github-user/routeplan

POSTGRES_DB=routeplan
POSTGRES_USER=routeplan
POSTGRES_PASSWORD=replace-with-at-least-24-random-characters
ROUTEPLAN_BACKUP_RETENTION_DAYS=14

ROUTEPLAN_SESSION_TIMEOUT=12h
ROUTEPLAN_SESSION_COOKIE_SECURE=true
ROUTEPLAN_AUTH_MAIL_MODE=SMTP
ROUTEPLAN_AUTH_TRUSTED_PROXIES=172.30.241.0/24
ROUTEPLAN_MODERATOR_EMAILS=admin@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM="RoutePlan <noreply@example.com>"

# Safe defaults keep paid providers disabled until their keys and quotas are ready.
ROUTEPLAN_PLACE_PROVIDER=DISABLED
ROUTEPLAN_ROUTE_PROVIDER=SIMPLE
ROUTEPLAN_AI_PROVIDER=RULE_BASED
ROUTEPLAN_ROUTE_CACHE_ENABLED=true
ROUTEPLAN_ROUTE_CACHE_KEY_PREFIX=routeplan:route:v1
ROUTEPLAN_ROUTE_CACHE_WALKING_TTL=7d
ROUTEPLAN_ROUTE_CACHE_DRIVING_TTL=15m
ROUTEPLAN_ROUTE_CACHE_TRANSIT_TTL=5m
ROUTEPLAN_WEATHER_AUTO_REFRESH_ENABLED=true

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com

ROUTEPLAN_EXTERNAL_RETRY_ENABLED=true
ROUTEPLAN_EXTERNAL_RETRY_MAX_ATTEMPTS=3
ROUTEPLAN_EXTERNAL_RETRY_INITIAL_DELAY=200ms
ROUTEPLAN_EXTERNAL_RETRY_MAX_DELAY=2s
ROUTEPLAN_EXTERNAL_RETRY_MULTIPLIER=2.0
ROUTEPLAN_EXTERNAL_RETRY_JITTER=0.2
ROUTEPLAN_EXTERNAL_RESILIENCE_ENABLED=true
ROUTEPLAN_CIRCUIT_FAILURE_THRESHOLD=5
ROUTEPLAN_CIRCUIT_OPEN_DURATION=30s
ROUTEPLAN_PROVIDER_MAX_CONCURRENT_CALLS=20
ROUTEPLAN_FAILURE_RATE_MINIMUM_CALLS=5
ROUTEPLAN_FAILURE_RATE_WARNING_PERCENT=50
ROUTEPLAN_ROUTE_CACHE_REFRESH_LOCK_TTL=15s
ROUTEPLAN_ROUTE_CACHE_REFRESH_WAIT=2s
ROUTEPLAN_ROUTE_CACHE_REFRESH_POLL_INTERVAL=100ms

ROUTEPLAN_USAGE_WARNING_PERCENT=80
GOOGLE_MONTHLY_SEARCH_LIMIT=4000
GOOGLE_MONTHLY_DETAILS_LIMIT=900
GOOGLE_MONTHLY_MATRIX_LIMIT=9000
GOOGLE_MONTHLY_GEOMETRY_LIMIT=9000
OPENAI_MONTHLY_REQUEST_LIMIT=500
OPENAI_MONTHLY_TOKEN_LIMIT=1000000
GOOGLE_PLACES_USD_PER_THOUSAND=0
GOOGLE_PLACE_DETAILS_USD_PER_THOUSAND=0
GOOGLE_ROUTES_USD_PER_THOUSAND=0
GOOGLE_GEOMETRY_USD_PER_THOUSAND=0
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
GOOGLE_MONTHLY_BUDGET_USD=0
OPENAI_MONTHLY_BUDGET_USD=0
