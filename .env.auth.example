# Optional additions to the existing .env. Do not overwrite existing API keys.
# Local Docker defaults: captured mail only, no delivery to real inboxes.
ROUTEPLAN_AUTH_MAIL_MODE=LOCAL
ROUTEPLAN_PUBLIC_URL=http://localhost:3100
MAILPIT_PORT=8026
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM=RoutePlan <noreply@routeplan.local>
ROUTEPLAN_SESSION_TIMEOUT=12h
ROUTEPLAN_SESSION_COOKIE_SECURE=false
# Empty: ignore forwarded headers. Production: explicitly allow only trusted proxy IPs/CIDRs.
ROUTEPLAN_AUTH_TRUSTED_PROXIES=

# Real SMTP example (replace values using your mail provider; never commit credentials):
# ROUTEPLAN_AUTH_MAIL_MODE=SMTP
# ROUTEPLAN_PUBLIC_URL=https://your-routeplan-domain.example
# SMTP_HOST=smtp.your-mail-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-app-password
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_FROM=RoutePlan <noreply@your-verified-domain.example>
# ROUTEPLAN_SESSION_COOKIE_SECURE=true
