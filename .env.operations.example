# V21 외부 API 운영 안전 한도 (UTC 월 기준, 재시도 포함)
ROUTEPLAN_USAGE_WARNING_PERCENT=80
GOOGLE_MONTHLY_SEARCH_LIMIT=4000
GOOGLE_MONTHLY_DETAILS_LIMIT=900
GOOGLE_MONTHLY_MATRIX_LIMIT=9000
GOOGLE_MONTHLY_GEOMETRY_LIMIT=9000
OPENAI_MONTHLY_REQUEST_LIMIT=500
OPENAI_MONTHLY_TOKEN_LIMIT=1000000

# 실제 계약/가격표의 USD 단가를 직접 입력할 때만 앱 추정 비용이 표시됩니다.
# Google은 앱에서 세는 단위 1,000개당, OpenAI는 토큰 1,000,000개당 값입니다.
GOOGLE_PLACES_USD_PER_THOUSAND=0
GOOGLE_PLACE_DETAILS_USD_PER_THOUSAND=0
GOOGLE_ROUTES_USD_PER_THOUSAND=0
GOOGLE_GEOMETRY_USD_PER_THOUSAND=0
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0

# 0이면 앱 비용 경고를 사용하지 않습니다. 공급자 청구 예산과 별도로 설정합니다.
GOOGLE_MONTHLY_BUDGET_USD=0
OPENAI_MONTHLY_BUDGET_USD=0

# V22 공급자별 장애 격리와 실패율 경고
ROUTEPLAN_EXTERNAL_RESILIENCE_ENABLED=true
ROUTEPLAN_CIRCUIT_FAILURE_THRESHOLD=5
ROUTEPLAN_CIRCUIT_OPEN_DURATION=30s
ROUTEPLAN_PROVIDER_MAX_CONCURRENT_CALLS=20
ROUTEPLAN_FAILURE_RATE_MINIMUM_CALLS=5
ROUTEPLAN_FAILURE_RATE_WARNING_PERCENT=50

# 동일 경로 캐시 미스의 다중 인스턴스 중복 갱신 방지
ROUTEPLAN_ROUTE_CACHE_REFRESH_LOCK_TTL=15s
ROUTEPLAN_ROUTE_CACHE_REFRESH_WAIT=2s
ROUTEPLAN_ROUTE_CACHE_REFRESH_POLL_INTERVAL=100ms
ROUTEPLAN_ROUTE_DB_CACHE_ENABLED=true
ROUTEPLAN_ROUTE_CACHE_DEPARTURE_BUCKET=15m
ROUTEPLAN_ROUTE_CACHE_DATABASE_BATCH_SIZE=500
ROUTEPLAN_ROUTE_CACHE_CLEANUP_INTERVAL=10m
ROUTEPLAN_ROUTE_CACHE_CLEANUP_BATCH_SIZE=5000

# 유료 Route Matrix를 시간 버킷별로 추가 조회하는 선택 기능. 예상 요소 상한을 먼저 조정합니다.
ROUTEPLAN_TIME_DEPENDENT_GLOBAL_ENABLED=false
ROUTEPLAN_TIME_DEPENDENT_BUCKET=1h
ROUTEPLAN_TIME_DEPENDENT_MAX_CANDIDATES=8
ROUTEPLAN_TIME_DEPENDENT_MAX_DAYS=3
ROUTEPLAN_TIME_DEPENDENT_MAX_MATRIX_BUILDS=36
ROUTEPLAN_TIME_DEPENDENT_MAX_MATRIX_ELEMENTS=2500
ROUTEPLAN_TIME_DEPENDENT_BEAM_WIDTH=512
ROUTEPLAN_TIME_DEPENDENT_MAX_STATES=250000
ROUTEPLAN_TIME_DEPENDENT_MAX_SEARCH_DURATION=5s
