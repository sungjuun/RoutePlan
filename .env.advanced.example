# Add these entries to .env; keep only one occurrence of each variable.
# Do not replace GOOGLE_MAPS_API_KEY with this browser key.
GOOGLE_MAPS_BROWSER_KEY=

# Enable Routes API in Google Cloud before changing SIMPLE to GOOGLE.
# ROUTEPLAN_ROUTE_PROVIDER=GOOGLE
# ROUTEPLAN_PLACE_PROVIDER=GOOGLE

# App safety ceilings, NOT a promise of zero charges.
GOOGLE_MONTHLY_SEARCH_LIMIT=4000
GOOGLE_MONTHLY_DETAILS_LIMIT=900
GOOGLE_MONTHLY_MATRIX_LIMIT=9000
GOOGLE_MONTHLY_GEOMETRY_LIMIT=9000

# Comma-separated trusted registered account emails. Empty disables moderation access.
ROUTEPLAN_MODERATOR_EMAILS=
